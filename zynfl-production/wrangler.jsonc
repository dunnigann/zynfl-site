{
  "name": "zynfl-site",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/auth/yahoo/*", "/api/yahoo/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "YAHOO_CONNECTION", "class_name": "YahooConnection" }]
  },
  "migrations": [
    { "tag": "v1-yahoo-connection", "new_sqlite_classes": ["YahooConnection"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
